{
  "name": "aerolit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently \"npm run dev:server\" \"npm run dev\"",
    "dev": "vite",
    "dev:server": "tsx watch server/server.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui --coverage --open=false",
    "coverage": "vitest run --coverage",
    "docs": "typedoc --entryPointStrategy expand ./src --out docs --name 'AeroLit API Documentation'"
  },
  "dependencies": {
    "@lit-labs/motion": "^1.1.0",
    "@lit-labs/router": "^0.1.4",
    "@phosphor-icons/web": "^2.1.2",
    "@phosphor-icons/webcomponents": "^2.1.5",
    "chart.js": "^4.5.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@open-wc/testing": "^5.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "jsdom": "^30.0.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
